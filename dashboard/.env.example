# Backend base URL (no trailing slash). Change to the laptop's LAN address on a hotspot.
VITE_API_BASE_URL=http://192.168.43.10:8000
# Set to true to use the in-memory sample data instead of the real server.
VITE_USE_FIXTURES=false
# Optional: your Photon-compatible venue search server and tile provider.
VITE_VENUE_SEARCH_URL=https://photon.komoot.io/api/
VITE_VENUE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
