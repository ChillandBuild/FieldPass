# Copy to backend/.env and fill in. Generate all four values with:
#   python -m app.gen_secrets
# JWT_SECRET must be at least 32 characters. PHOTO_ENCRYPTION_KEY must be a Fernet key.
JWT_SECRET=
PHOTO_ENCRYPTION_KEY=
# Password of the student demo accounts (student1..student3)
SEED_PASSWORD=
# Password of the faculty demo account (faculty1). Required, and must differ from SEED_PASSWORD.
FACULTY_SEED_PASSWORD=
# Set to true to serve the interactive API docs at /docs and /openapi.json (off by default)
ENABLE_DOCS=false
DATABASE_PATH=data/fieldpass.db
# --- Supabase Storage (optional; leave blank to keep encrypted photos on local disk) ---
# Encrypted enrollment photos go to the private bucket below instead of PHOTO_DIR.
SUPABASE_URL=https://dmjcjiihnvdrpqyckwlu.supabase.co
# service_role / secret key (Dashboard > Settings > API Keys). Server-side only.
SUPABASE_SERVICE_KEY=
SUPABASE_PHOTO_BUCKET=enrollment-photos
# Comma-separated list of dashboard origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SFace cosine-similarity threshold (OpenCV sample: 0.363). Scores in
# [threshold - margin, threshold) are "uncertain"; lower is "no_match".
FACE_MATCH_THRESHOLD=0.363
FACE_UNCERTAIN_MARGIN=0.1
# Minimum face-detector confidence (default 0.9). Lower (e.g. 0.8) accepts close-up or dim selfies.
FACE_DETECT_SCORE=0.9
# Head-turn check: the straight photo's nose offset must be within +/-FRONT_MAX, the turned one past TURN_MIN.
# Set LIVENESS_MIRRORED=true if the phone's front-camera photos come out mirrored (calibrate: scripts/nose_offset.py).
LIVENESS_FRONT_MAX_OFFSET=0.12
LIVENESS_TURN_MIN_OFFSET=0.25
LIVENESS_MIRRORED=false
ATTEMPT_TTL_SECONDS=90
# How early check-in opens before an activity starts, and how long check-out stays open after it ends.
# Minutes, may be fractional (0.5 = 30 s), 0 to 10080. Defaults 15 and 30; the contract text says the same.
CHECKIN_LEAD_MINUTES=15
CHECKOUT_GRACE_MINUTES=30
LOCATION_MAX_AGE_SECONDS=60
TOKEN_TTL_MINUTES=480
# Postgres (Supabase). Paste the "Session pooler" connection string (port 5432, not the 6543 transaction pooler).
# Leave empty to use SQLite at DATABASE_PATH. Tables go in DATABASE_SCHEMA, created on first start.
DATABASE_URL=
DATABASE_SCHEMA=fieldpass
